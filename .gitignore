!**/.env.example

# Private keys/certificates (do not commit real credentials)
*.pem
*.key
*.p12
*.pfx

# Local databases and their journal files
*.db
*.db-*
*.sqlite
*.sqlite3

# Operating-system files
.DS_Store
Thumbs.db
