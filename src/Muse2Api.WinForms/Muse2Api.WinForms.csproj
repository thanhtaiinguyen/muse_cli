<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows compiling (not running) the Windows UI on Linux/macOS for CI checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Muse2Api.WinForms</AssemblyName>
    <RootNamespace>Muse2Api.WinForms</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
