<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Muse2Api</AssemblyName>
    <RootNamespace>Muse2Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="data\**;**\browser-sessions\**;**\accounts.json;**\keys.json;**\tasks.json;**\requests.db;**\api_key" />
    <None Update="data\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
